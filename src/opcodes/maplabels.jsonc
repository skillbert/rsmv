{
	"0x01": { "name":                              "sprite", "read": "varuint", "type": "graphic" },
	"0x02": { "name":                        "sprite_hover", "read": "varuint", "type": "graphic" },
	"0x03": { "name":                                "text", "read": "string" },
	"0x04": { "name":                             "color_1", "read": ["tuple","ubyte","ubyte","ubyte"], "type": "rgb" },
	"0x05": { "name":                             "color_2", "read": ["tuple","ubyte","ubyte","ubyte"], "type": "rgb" },
	"0x06": { "name":                           "font_size", "read": "ubyte" },
	"0x07": { "name":                          "unknown_07", "read": "ubyte" },
	"0x08": { "name":                          "unknown_08", "read": "ubyte" },
	"0x09": { "name":                            "toggle_1", "read": ["struct",
                                                                        ["varbit","ushort","varbit"],
                                                                        ["varp","ushort","var_player"],
                                                                        ["lower","uint","maplabel"],
                                                                        ["upper","uint","maplabel"]
                                                                    ] },
    "0x0a": { "name":                        "rightclick_1", "read": "string" },
    "0x0b": { "name":                          "unktext_0b", "read": "string" },
	"0x0f": { "name":                             "polygon", "read": ["struct",
                                                                        ["pointcount","ubyte"],
                                                                        ["points",["array",["ref","pointcount"],["struct",
                                                                            ["x","short"],
                                                                            ["y","short"]
                                                                        ]]],
                                                                        ["color",["tuple","ubyte","ubyte","ubyte","ubyte"],"argb"],
                                                                        ["always_1",["match","buildnr",{">=623":"ubyte","other":1}]],
                                                                        //back color and color are also flipped before 623
                                                                        ["back_color",["tuple","ubyte","ubyte","ubyte","ubyte"],"argb"],
                                                                        ["pointplanes",["match","buildnr",{
                                                                            ">=629":["array",["ref","pointcount"],"ubyte"],
                                                                            "other":null
                                                                        }]]
                                                                    ] },
	"0x11": { "name":                        "rightclick_2", "read": "string" },
	"0x13": { "name":                            "category", "read": "ushort", "type": "category" },
	"0x14": { "name":                            "toggle_2", "read": ["struct",
                                                                        ["varbit","ushort","varbit"],
                                                                        ["varp","ushort","var_player"],
                                                                        ["lower","uint","maplabel"],
                                                                        ["upper","uint","maplabel"]
                                                                    ] },
	"0x15": { "name":                          "unknown_15", "read": "int" },
	"0x16": { "name":                          "unknown_16", "read": "int" },
	"0x19": { "name":                   "background_sprite", "read": "varuint", "type": "graphic" },
	"0x1a": { "name":                       "legacy_switch", "read": ["struct",
                                                                        ["varbit","ushort","varbit"],
                                                                        ["varp","ushort","var_player"],
                                                                        ["value","ubyte"],
                                                                        ["default_ref","ushort","maplabel"],
                                                                        ["legacy_ref","ushort","maplabel"]
                                                                    ] },
	"0x1c": { "name":                          "unknown_1c", "read": "ubyte" },
	"0x1e": { "name":                          "unknown_1e", "read": "ubyte" },
	"0xF9": { "name":                               "extra", "read": "extrasmap", "type": "params" }
}
["typed",["struct",
    // treating first byte as a version to deduplicate code, however it seems to be
    // a config style layout where 0x01 and 0x02 imply entirely different fields
    ["version","ubyte"],
    ["unkint",["opt","version>=2","uint"]],
    ["cols",["opt","version!=0","ubyte"]],
    ["columndata",["opt","version!=0",["nullarray","ubyte",255,["struct",
        ["id",["ref","$opcode",[0,6]]],
        ["flags",["ref","$opcode",[6,2]]],
        ["$i",0],
        ["$default",0],
        ["unkbyte",["opt","version>=2","ubyte"]],
        ["columns",["chunkedarray","ubyte",[
            ["type",["typed","varushort","type"]],
            ["$colindex",["accum","$i",1]]
        ],[
            ["flagsbyte",["accum","$default",["match",{"$colindex==1 && version>=2":"ubyte","other":0}]]]
        ],[
            ["hasdefault",["match",{"version>=2 && flagsbyte&0x2":1,"version<=1 && id&0x80":1,"other":0}]],
            ["unk1",["opt","hasdefault==1 && $colindex==1","ubyte"]],//this is dumb, there is currently no way to read a byte between chunkedarray chunks
            ["default",["opt","hasdefault==1",["match",["ref","type"],{
                //in theory there are about 10 possible non-int types (either string or long), but only these are observed
                "0x24":"string",
                "other":"int"
            }]]],
            ["unk2",["opt","hasdefault==1 && $colindex==1","ubyte"]]
        ]]]
    ]]]],
    ["nullbyte",["opt","version!=0","ubyte"]]
],"dbtable_definition"]
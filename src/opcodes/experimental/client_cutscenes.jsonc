// seems to refer to client sided 3d cutscenes
// hasn't been used since 2012, and it seems like some of the ids this file refers to have already been
// reallocated, or their entire index removed from cache.
// it's unclear to me if the client still uses this

["struct",
	["head",["buffer",6,"hex"]],
	["mapsquares",["array","ubyte",["struct",
		["src_chunk","uint"],//[28-32 level][20-28 chunkx][14-20 subx][6-14 chunkz][0-6 subz]
		["src_level",["ref","src_chunk",[28,3]]],
		["src_chunkx",["ref","src_chunk",[20,8]]],
		["src_chunkz",["ref","src_chunk",[6,8]]],
		["sizex","ubyte"],//measures in 8x8 subchunks
		["sizez","ubyte"],
		["dst_plane","ubyte"],
		["dst_x","ubyte"],//measured in 8x8
		["dst_z","ubyte"],
		["unk0","ubyte"]//could be rotation
	]]],
	["arr2",["array","ubyte",["array","ubyte",["struct",["v",["buffer",14,"hex"]]]]]],
	["npcs",["array","ubyte",["struct",
		["type","ubyte"],//0=npc,1=player
		["npcid",["opt","type=0","ushort"],"npc"],
		["name","string"]
	]]],
	["locs",["array","ubyte",["tuple",["typed","varuint","loc"],"ubyte"]]],
	["arr5",["array","ubyte",["array","ubyte",["struct",["v",["buffer",5,"hex"]]]]]],//often length as arr2
	["keyframes",["array","varushort",["struct",
		["op","ubyte"],
		["time","ushort"],
		["v",["match",["ref","op"],{
			"0x01":["struct",
				["arr2_index","ushort"],
				["arr2_index2","ushort"],
				["sub1","ushort"],
				["sub2","ushort"],//always same as sub1
				["unk1","ushort"],
				["unk2","ushort"]//always same as unk1
			],
			"0x0a":["struct",
				["npcindex","ushort"],
				["x","ushort"],
				["z","ushort"],
				["unkbyte","ubyte"],//0-3 rotation? vast majority 0 though (1138x 0, ~20x 1-3)
				["end","varushort"]//would expect seq, but its not, high concentation at -2
			],
			"0x0b":["struct",
				["npcindex","ushort"]
			],
			"0x0c":["struct",
				["npcindex","ushort"],
				["arr2_5_index","ushort"],
				["subindex2","ubyte"]
			],
			"0x0e":["struct",
				["npcindex","ushort"],
				["seq","ushort","seq"],
				["always0","uint"]
			],
			"0x11":["buffer",10,"hex"],//some id up to 3881, followed by mostly 0s and a number up to 79
			"0x14":["struct",
				["locindex","ushort"],
				["x","ushort"],
				["z","ushort"],
				["plane","ubyte"],//plane/rotation might be swapped
				["rotation","ubyte"]
			],
			"0x15":["struct",
				["locindex","ushort"]
			],
			"0x16":["struct",
				["npcindex","ushort"],
				["end","ushort"]//similar spread to 0x0a end
			],
			"0x1e":["struct",
				["unk0","ushort"],
				["alwaysff","ubyte"]
			],
			"0x21":["struct",
				["sound","ushort","sound"],
				["unk0","ubyte"],
				["unk1","ubyte"],
				["always1","ubyte"]
			],
			"0x28":["buffer",6,"hex"],//seem to be a set of manually tuned u8s
			"0x46":["struct",
				["text","string"],//subtitle
				["unk1","ushort"]//probly duration
			],
			"0xff":true
		}]]
	]]]
]

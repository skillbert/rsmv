//41.x.0

// contains tile data for mapzones
// 1 byte when tile has no "shape"
// - seems to be 6bit index into some unknown lookup table
// 3 or 4 bytes for complex tiles
// - contains overlay/underlay ids literally
// - some other encoding for shape
["struct",
  ["underlays",["array","ubyte","varushort"]],
  ["overlays",["array","ubyte","varushort"]],
  // header
  ["data",["nullarray",["bytesleft"],["struct",
    ["chunksize",["match","ubyte",{"0":64,"1":8}]],//1 means 8x8 subchunks, 0 probably means 64x64
    ["x","ubyte"],
    ["z","ubyte"],
    ["subx","ubyte"],
    ["subz","ubyte"],
    ["level","ubyte"],
    ["unkheader",["opt","chunksize=64",["buffer",5,"hex"]]],
    // tile data
    ["tiles",
      ["array",["ref","chunksize"],["ministruct",["v",
        ["array",["ref","chunksize"],["ministruct",["v",["match","ubyte",{
          "0x01":["tuple","varushort","varushort","ubyte"],//loc
          "0x03":["tuple","varushort","varushort"],
          "0x05":["tuple","varushort","varushort","varushort"],
          //7 doesn't seem to be in use
          
          "0x09":["tuple","varushort","varushort",                 "ubyte"],
          "0x0b":["tuple","varushort","varushort",                 "ubyte",                            "varushort","varushort","ubyte"],
          "0x0d":["tuple","varushort","varushort",                 "ubyte",                            "varushort","varushort","ubyte",                                              "varushort","varushort","ubyte"],
          "0x0f":["tuple","varushort","varushort",                 "ubyte",                            "varushort","varushort","ubyte",                                              "varushort","varushort","ubyte",                                               "varushort","varushort","ubyte"],
          
          "0x11":["tuple",            "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]]],
          "0x13":["tuple",            "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]],           "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]]],
          "0x15":["tuple",            "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]],           "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]],             "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]]],
          "0x17":["tuple",            "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]],           "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]],             "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]],            "varushort",        ["array","ubyte",["tuple","varuint","ubyte"]]],

          "0x19":["tuple","varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]]],
          "0x1b":["tuple","varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]],"varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]]],
          "0x1d":["tuple","varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]],"varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]],"varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]]],
          "0x1f":["tuple","varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]],"varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]],"varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]],"varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]]],

          // seems like they ran out of opcodes...
          "0xfc":"varushort",
          "0xfe":["tuple","varushort","varushort"],

          // all with ending bits 10
          "&=0x02 && !&0x1":"varushort",

          // ops above 0x20 seem to be exempt from flags 1 and 2
          "&0xe0":["ref","$opcode"],
          //mark all with flag 0x1 or 0x2 in debug view
          // "&0x03":["struct",["unknownop",true]],
          "&0x03":["buffer",12312123312,"hex"],
          //all values without 0x3 are indexes into the palette
          "other":["ref","$opcode"]
        }]]]]
      ]]]
  ]]]]
]



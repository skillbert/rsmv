//41.x.0

// contains tile data for mapzones
// 1 byte when tile has no "shape"
// - seems to be 5bit index into some unknown lookup table
// 3 or 4 bytes for complex tiles
// - contains overlay/underlay ids literally
// - some other encoding for shape
// only simple cases are understood, there are still lots of uknown
// - first byte per tile could also be hardcoded opcode where majority are fixed colors
// - length of array seems to decided externally, seems to correlate with number of chunks/size of mappastes in mapzones
["struct",
  ["underlays",["array","ubyte","varushort"]],
  ["overlays",["array","ubyte","varushort"]],
  // header
  ["data",["nullarray",["bytesleft"],["struct",
    ["chunksize",["match","ubyte",{"0":64,"1":8}]],//1 means 8x8 subchunks, 0 probably means 64x64
    ["x","ubyte"],
    ["z","ubyte"],
    ["subx","ubyte"],
    ["subz","ubyte"],
    ["level","ubyte"],
    ["unkheader",["opt","chunksize=64",["buffer",5,"hex"]]],
    // tile data
    ["tiles",
      ["array",["ref","chunksize"],["ministruct",["v",
        ["array",["ref","chunksize"],["ministruct",["v",["match","ubyte",{
          "0x01":["tuple","varuint","ubyte"],//loc
          "0x09":["tuple","varushort","varushort","ubyte"],
          "0x19":["tuple","varushort","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]]],
          
          "0x03":["tuple","ubyte","ubyte"],
          "0x11":["tuple","varushort",["array","ubyte",["tuple","varuint","ubyte"]]],
          "0x13":["tuple","varushort",["array","ubyte",["tuple","varuint","ubyte"]],"ubyte",["array","ubyte",["tuple","varuint","ubyte"]]],
          "0x0b":["tuple","varushort","varushort","ushort","varushort","byte"],
          "0x1b":["tuple","varushort","ushort",["array","ubyte",["tuple","ushort","ubyte"]],"ubyte","varushort","ubyte",["array","ubyte",["tuple","varuint","ubyte"]]],

          // not flag1
          "0x02":"varushort",//water?
          "0x06":"varushort",
          "0x0a":"varushort",
          "0x0e":"varushort",
          "0x12":"varushort",
          
          //mark all with flag 0x1 or 0x2 in debug view
          "&0x03":["struct",["unknown op",true]],
          //all values without 0x3 are indexes into the palette
          "other":true
        }]]]]
      ]]]
  ]]]]
]





